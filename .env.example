# Chave de API da Resend — https://resend.com/api-keys
# Precisa de permissão de envio (Full access ou Sending access).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Segredo de assinatura do webhook — https://resend.com/webhooks
# Mostrado como "Signing Secret" na página do webhook, começa com whsec_.
# Sem ele o endpoint rejeita tudo com 401.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
